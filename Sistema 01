<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Transporte Particular</title>

<style>

/* =========================
   CONFIGURAÇÃO GERAL
========================= */

* {
    box-sizing: border-box;
}

body {
    margin: 0;
    font-family: Arial, Helvetica, sans-serif;
    background: #f4f6f8;
    color: #17202a;
}

button,
input,
select {
    font-family: inherit;
}

.container {
    width: 100%;
    max-width: 620px;
    margin: auto;
    padding: 15px;
}


/* =========================
   CABEÇALHO
========================= */

.header {
    background: #111827;
    color: white;
    padding: 28px 18px;
    text-align: center;
    border-radius: 0 0 22px 22px;
}

.header .icone {
    font-size: 42px;
}

.header h1 {
    margin: 8px 0 5px;
    font-size: 26px;
}

.header p {
    margin: 0;
    font-size: 15px;
    opacity: .85;
}


/* =========================
   CARTÕES
========================= */

.card {
    background: white;
    border-radius: 18px;
    padding: 20px;
    margin-bottom: 16px;
    box-shadow: 0 4px 15px rgba(0,0,0,.07);
}

.card h2 {
    margin: 0 0 15px;
    font-size: 19px;
}


/* =========================
   FORMULÁRIOS
========================= */

label {
    display: block;
    font-weight: bold;
    font-size: 14px;
    margin: 13px 0 6px;
}

input,
select {
    width: 100%;
    padding: 14px;
    border: 1px solid #d1d5db;
    border-radius: 10px;
    font-size: 16px;
    background: white;
    outline: none;
}

input:focus,
select:focus {
    border-color: #2563eb;
}

.grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
}


/* =========================
   BOTÕES
========================= */

button {
    width: 100%;
    border: none;
    padding: 15px;
    border-radius: 11px;
    font-size: 16px;
    font-weight: bold;
    cursor: pointer;
    margin-top: 10px;
}

.btn-principal {
    background: #16a34a;
    color: white;
}

.btn-principal:hover {
    background: #15803d;
}

.btn-secundario {
    background: #2563eb;
    color: white;
}

.btn-whatsapp {
    background: #25d366;
    color: white;
}

.btn-limpar {
    background: #e5e7eb;
    color: #111827;
}


/* =========================
   AVISO
========================= */

.aviso {
    background: #eef5ff;
    border-left: 4px solid #2563eb;
    padding: 13px;
    border-radius: 8px;
    font-size: 14px;
    line-height: 1.5;
    margin-top: 12px;
}


/* =========================
   RESULTADO DO CLIENTE
========================= */

.resultado-cliente {
    display: none;
}

.preco {
    text-align: center;
    background: #f0fdf4;
    border-radius: 15px;
    padding: 20px;
    margin-top: 15px;
}

.preco small {
    display: block;
    font-size: 14px;
    margin-bottom: 5px;
}

.preco strong {
    display: block;
    font-size: 38px;
    color: #15803d;
}


/* =========================
   LINHAS DE INFORMAÇÃO
========================= */

.linha {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    padding: 11px 0;
    border-bottom: 1px solid #edf0f2;
}

.linha:last-child {
    border-bottom: none;
}

.linha span:first-child {
    color: #667085;
}

.linha strong {
    text-align: right;
}


/* =========================
   PAINEL MOTORISTA
========================= */

.painel-motorista {
    display: none;
}

.motorista-header {
    background: #111827;
    color: white;
    padding: 15px;
    border-radius: 12px;
    margin-bottom: 15px;
}

.motorista-header strong {
    display: block;
    font-size: 19px;
}

.motorista-header span {
    font-size: 13px;
    opacity: .8;
}

.resultado-motorista {
    display: none;
}

.lucro-box {
    margin-top: 15px;
    padding: 18px;
    background: #f0fdf4;
    border-radius: 14px;
    text-align: center;
}

.lucro-box span {
    display: block;
    font-size: 14px;
}

.lucro-box strong {
    display: block;
    font-size: 28px;
    color: #15803d;
}


/* =========================
   CONFIGURAÇÕES
========================= */

.configuracao {
    background: #fff7ed;
    border-left: 4px solid #f97316;
    padding: 13px;
    border-radius: 8px;
    font-size: 13px;
    line-height: 1.5;
}


/* =========================
   RODAPÉ
========================= */

.footer {
    text-align: center;
    color: #667085;
    font-size: 12px;
    padding: 20px 5px;
}


/* =========================
   RESPONSIVO
========================= */

@media (max-width: 480px) {

    .grid {
        grid-template-columns: 1fr;
    }

    .header h1 {
        font-size: 23px;
    }

    .card {
        padding: 17px;
    }

    .preco strong {
        font-size: 34px;
    }
}

</style>
</head>


