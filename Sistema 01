<script>

/* =====================================================
   CONFIGURAÇÕES DO SISTEMA
===================================================== */

const CONFIG = {

    valorPorKm: 3.00,

    precoCombustivel: 6.95,

    consumoKmLitro: 10,

    esperaPorMinuto: 2.00,

    estacionamentoPorHora: 15.00,

    valorMinimo: 35.00

};


/* =====================================================
   FORMATAÇÃO DE DINHEIRO
===================================================== */

function dinheiro(valor) {

    return valor.toLocaleString(
        "pt-BR",
        {
            style: "currency",
            currency: "BRL"
        }
    );

}


/* =====================================================
   CALCULAR CORRIDA
===================================================== */

function calcularCorrida() {


    /* Dados */

    const nome =
        document.getElementById("nome").value.trim();

    const telefone =
        document.getElementById("telefone").value.trim();

    const origem =
        document.getElementById("origem").value.trim();

    const destino =
        document.getElementById("destino").value.trim();

    const passageiros =
        document.getElementById("passageiros").value;


    /* Distâncias */

    const kmBusca =
        Number(
            document.getElementById("kmBusca").value
        ) || 0;


    const kmViagem =
        Number(
            document.getElementById("kmViagem").value
        ) || 0;


    const kmTotal =
        kmBusca + kmViagem;


    /* Extras */

    const espera =
        Number(
            document.getElementById("espera").value
        ) || 0;


    const estacionamento =
        Number(
            document.getElementById("estacionamento").value
        ) || 0;


    const pedagio =
        Number(
            document.getElementById("pedagio").value
        ) || 0;


    /* Cálculo da distância */

    const valorDistancia =
        kmTotal * CONFIG.valorPorKm;


    /* Cálculo da espera */

    const valorEspera =
           const valorEspera =
        espera * CONFIG.esperaPorMinuto;


    /* Cálculo do estacionamento */

    const valorEstacionamento =
        estacionamento *
        CONFIG.estacionamentoPorHora;


    /* Subtotal da corrida */

    const subtotal =
        valorDistancia +
        valorEspera +
        valorEstacionamento +
        pedagio;


    /* Aplicação do valor mínimo */

    const total =
        Math.max(
            subtotal,
            CONFIG.valorMinimo
        );


    const minimoAplicado =
        subtotal < CONFIG.valorMinimo;


    /* =========================
       CÁLCULO DO COMBUSTÍVEL
    ========================= */

    const litros =
        kmTotal /
        CONFIG.consumoKmLitro;


    const custoCombustivel =
        litros *
        CONFIG.precoCombustivel;


    const lucro =
        total -
        custoCombustivel;


    /* =========================
       RESULTADO PARA O CLIENTE
    ========================= */

    document.getElementById("clienteKm")
        .textContent =
        kmTotal.toFixed(1) + " km";


    document.getElementById("clienteEspera")
        .textContent =
        espera + " min";


    document.getElementById("clienteEstacionamento")
        .textContent =
        dinheiro(valorEstacionamento);


    document.getElementById("clientePedagio")
        .textContent =
        dinheiro(pedagio);


    document.getElementById("clienteTotal")
        .textContent =
        dinheiro(total);


    document.getElementById("resultadoCliente")
        .style.display =
        "block";


    /* =========================
       RESULTADO PARA O MOTORISTA
    ========================= */

    document.getElementById("motoristaNome")
        .textContent =
        nome || "Não informado";


    document.getElementById("motoristaTelefone")
        .textContent =
        telefone || "Não informado";


    document.getElementById("motoristaOrigem")
        .textContent =
        origem || "Não informado";


    document.getElementById("motoristaDestino")
        .textContent =
        destino || "Não informado";


    document.getElementById("motoristaPassageiros")
        .textContent =
        passageiros;


    document.getElementById("motoristaKmBusca")
        .textContent =
        kmBusca.toFixed(1) + " km";


    document.getElementById("motoristaKmViagem")
        .textContent =
        kmViagem.toFixed(1) + " km";


    document.getElementById("motoristaKmTotal")
        .textContent =
        kmTotal.toFixed(1) + " km";


    document.getElementById("motoristaDistancia")
        .textContent =
        dinheiro(valorDistancia);


    document.getElementById("motoristaEspera")
        .textContent =
        dinheiro(valorEspera);


    document.getElementById("motoristaEstacionamento")
        .textContent =
        dinheiro(valorEstacionamento);


    document.getElementById("motoristaPedagio")
        .textContent =
        dinheiro(pedagio);


    document.getElementById("motoristaSubtotal")
        .textContent =
        dinheiro(subtotal);


    document.getElementById("motoristaMinimo")
        .textContent =
        minimoAplicado
            ? "Sim"
            : "Não";


    document.getElementById("motoristaTotal")
        .textContent =
        dinheiro(total);


    document.getElementById("motoristaLitros")
        .textContent =
        litros.toFixed(2) + " L";


    document.getElementById("motoristaCombustivel")
        .textContent =
        dinheiro(custoCombustivel);


    document.getElementById("motoristaLucro")
        .textContent =
        dinheiro(lucro);


    /* =========================
       GUARDAR DADOS DA CORRIDA
    ========================= */

    window.dadosCorrida = {

        nome: nome,

        telefone: telefone,

        origem: origem,

        destino: destino,

        passageiros: passageiros,

        kmTotal: kmTotal,

        total: total

    };

}


/* =========================
   WHATSAPP
========================= */

function enviarWhatsApp() {

    if (!window.dadosCorrida) {

        alert(
            "Primeiro calcule o valor da corrida."
        );

        return;

    }


    const dados =
        window.dadosCorrida;


    /*
       COLOQUE AQUI O WHATSAPP
       DO MOTORISTA.

       SOMENTE NÚMEROS.

       Exemplo:
       5511999999999
    */

    const telefoneMotorista =
        "5511999999999";


    const mensagem =

        "🚗 *SOLICITAÇÃO DE TRANSPORTE PARTICULAR*" +

        "\n\n" +

        "👤 Cliente: " +
        dados.nome +

        "\n📱 WhatsApp: " +
        dados.telefone +

        "\n📍 Embarque: " +
        dados.origem +

        "\n🏁 Destino: " +
        dados.destino +

        "\n👥 Passageiros: " +
        dados.passageiros +

        "\n🛣️ Distância estimada: " +
        dados.kmTotal.toFixed(1) +
        " km" +

        "\n💰 Valor estimado: " +
        dinheiro(dados.total) +

        "\n\n" +

        "Gostaria de confirmar esta viagem.";


    const url =

        "https://wa.me/" +
        telefoneMotorista +
        "?text=" +
        encodeURIComponent(mensagem);


    window.open(
        url,
        "_blank"
    );

}


/* =========================
   ÁREA DO MOTORISTA
========================= */

function abrirMotorista() {

    document.getElementById(
        "areaCliente"
    ).style.display =
        "none";


    document.getElementById(
        "areaMotorista"
    ).style.display =
        "block";


    window.scrollTo(
        0,
        0
    );

}


/* =========================
   VOLTAR PARA CLIENTE
========================= */

function voltarCliente() {

    document.getElementById(
        "areaMotorista"
    ).style.display =
        "none";


    document.getElementById(
        "areaCliente"
    ).style.display =
        "block";


    window.scrollTo(
        0,
        0
    );

}


/* =========================
   LIMPAR SISTEMA
========================= */

function limparSistema() {

    document.querySelectorAll(
        "input"
    ).forEach(
        function(campo) {

            if (
                campo.type === "number"
            ) {

                if (
                    campo.id === "pedagio" ||
                    campo.id === "espera" ||
                    campo.id === "estacionamento"
                ) {

                    campo.value = 0;

                } else {

                    campo.value = "";

                }

            } else {

                campo.value = "";

            }

        }
    );


    document.getElementById(
        "resultadoCliente"
    ).style.display =
        "none";


    document.getElementById(
        "resultadoMotorista"
    ).style.display =
        "none";


    window.dadosCorrida =
        null;

}

</script>

